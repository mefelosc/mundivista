{
	"name": "mundivista",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"data:build": "node tools/build-data.mjs",
		"data:refresh": "node tools/build-data.mjs --refresh",
		"data:subdivisions": "node tools/build-subdivisions.mjs",
		"shots": "node tools/screenshots.mjs",
		"smoke": "node tools/smoke.mjs",
		"a11y": "node tools/a11y.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/geojson": "^7946.0.16",
		"jsdom": "^30.1.3",
		"playwright": "^1.64.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.12"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"d3-array": "^3.2.4",
		"d3-scale": "^4.0.2",
		"flag-icons": "^7.6.0",
		"maplibre-gl": "^6.16.0",
		"proj4": "^2.22.0"
	}
}
